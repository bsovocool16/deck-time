{
  "name": "deck-time-plugin",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.bsovocool.decktime\"",
    "link": "streamdeck link com.bsovocool.decktime.sdPlugin",
    "validate": "streamdeck validate com.bsovocool.decktime.sdPlugin",
    "pack": "streamdeck pack com.bsovocool.decktime.sdPlugin --output ../dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^24.0.0",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.9.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
