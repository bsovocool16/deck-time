{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "decktime-infobar",
  "controller": "Neo",
  "items": [
    {
      "key": "title",
      "type": "text",
      "rect": [
        16,
        2,
        184,
        22
      ],
      "alignment": "center",
      "text-overflow": "ellipsis",
      "font": {
        "size": 14,
        "weight": 500
      },
      "color": "#8A8A84"
    },
    {
      "key": "value",
      "type": "text",
      "rect": [
        16,
        24,
        184,
        24
      ],
      "alignment": "center",
      "font": {
        "size": 20,
        "weight": 700
      },
      "color": "#F2F2EF"
    }
  ]
}
